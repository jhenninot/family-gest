# ==============================================================================
# 🏡 FamilyGest - Configuration des Variables d'Environnement (.env)
# ==============================================================================
# Renommez ce fichier en .env ou configurez directement ces variables dans Dockge.

# Port d'accès à l'application web sur la machine hôte
APP_PORT=5000

# Clé secrète pour signer les jetons de session (JWT)
# IMPORTANT : Personnalisez cette clé pour sécuriser vos sessions
JWT_SECRET=changez_cette_cle_secrete_par_une_chaine_aleatoire_et_longue_123456

# Mode d'exécution
NODE_ENV=production
